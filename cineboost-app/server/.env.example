# ---- Required ----
PORT=8787
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# ---- Google OAuth (frontend uses GIS One-Tap or button) ----
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=

# ---- TMDB ----
# Free key: https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 read-access token works.
TMDB_KEY=

# ---- OMDb (gives IMDb + Rotten Tomatoes + Metacritic scores) ----
# Free 1k/day at https://www.omdbapi.com/apikey.aspx
OMDB_KEY=

# ---- Gemini (AI summaries: critic vs. audience juxtaposition) ----
# Free tier at https://aistudio.google.com/apikey (15 RPM, 1500 RPD on flash)
GEMINI_API_KEY=

# ---- DB ----
DB_PATH=./cineboost.db
